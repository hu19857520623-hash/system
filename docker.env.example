# 复制为 .env 后启动：docker compose up --build
# 端口与本地 npm run dev 默认一致：ERP 3000/5180，OMS 3001/5173，MySQL 3307

# ── MySQL ──
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_HOST_PORT=3307

# ── 共享密钥（ERP ↔ OMS 须一致，各至少 32 字符）──
JWT_SECRET=local-dev-jwt-secret-at-least-32-characters
OMS_JWT_SECRET=local-oms-jwt-secret-at-least-32-characters
OMS_INTERNAL_TOKEN=e2e-internal-token-2026-at-least-32-characters
OMS_WEBHOOK_SECRET=p0-e2e-shared-secret

# ── CORS ──
CORS_ORIGINS=http://127.0.0.1:5180,http://localhost:5180,http://127.0.0.1:5173,http://localhost:5173
OMS_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5180,http://localhost:5180

# ── 可选：首次启动自动 prisma db push（生产勿开）──
AUTO_SCHEMA_SYNC=false

# ── OMS 开发登录（仅本地 Docker）──
OMS_ALLOW_INSECURE_DEV_AUTH=true
OMS_BOOTSTRAP_ADMIN_USERNAME=omsadmin
OMS_BOOTSTRAP_ADMIN_PASSWORD=DevAdmin123!

# ── 端口覆盖（一般不用改）──
# ERP_BACKEND_PORT=3000
# ERP_FRONTEND_PORT=5180
# OMS_API_PORT=3001
# OMS_WEB_PORT=5173

# ── 国内 Docker Hub 镜像前缀（可选）──
# DOCKER_REGISTRY=docker.m.daocloud.io/library/
