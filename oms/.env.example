# OMS MySQL（与 ERP 共用 takealot_erp，OMS 物理表前缀 oms_）
DATABASE_URL="mysql://root:your-password@127.0.0.1:3307/takealot_erp"
API_PORT=3001
LISTEN_HOST=127.0.0.1
# ERP Nest 网关（P0 货盘/客户/余额）
ERP_API_BASE="http://127.0.0.1:3000/api"
# ERP canonical onboarding path (override only if ERP is mounted differently)
ERP_OMS_PROVISION_PATH="/customers/oms/provision"
# ERP internal customer update path; :customerCode is URL-encoded by OMS
ERP_OMS_UPDATE_PATH="/customers/oms/by-code/:customerCode"
# ERP internal portal reset path; :customerCode is URL-encoded by OMS
ERP_OMS_RESET_PASSWORD_PATH="/customers/oms/by-code/:customerCode/portal-password"
# Shared internal token sent only by the OMS server as x-oms-internal-token
OMS_INTERNAL_TOKEN="请替换为 ERP 与 OMS 共用的随机内部令牌"
# OMS portal JWT signing secret; required in every non-development environment
OMS_JWT_SECRET="请替换为至少 32 字节的随机密钥"
# Explicit local-only fallback (never enable in staging/production):
# NODE_ENV=development
# OMS_ALLOW_INSECURE_DEV_AUTH=true
# Optional environment-provisioned system administrator. Both values are required;
# the password is bcrypt-hashed and is never persisted or printed as plaintext.
# OMS_BOOTSTRAP_ADMIN_USERNAME="omsadmin"
# OMS_BOOTSTRAP_ADMIN_PASSWORD="请替换为至少 6 位的临时密码"
# With the explicit development fallback enabled and both values omitted, use
# omsadmin / DevAdmin123! and change the password immediately after login.
# ERP → OMS Webhook 签名密钥；须与 ERP 一致，未配置时 Webhook 返回 503
OMS_WEBHOOK_SECRET="请替换为 ERP 与 OMS 共用的随机密钥"
# 生产环境必须配置；开发默认含 5173 / 5180
# OMS_CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
