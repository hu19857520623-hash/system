# Copy this file to .env before starting the production ERP Compose project.
ERP_MYSQL_ROOT_PASSWORD=replace-with-a-production-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
OMS_INTERNAL_TOKEN=replace-with-the-same-random-token-used-by-oms
OMS_WEBHOOK_SECRET=replace-with-the-same-random-secret-used-by-oms
CORS_ORIGINS=https://erp.sztekeluo.com,https://www.erp.sztekeluo.com
AUTO_SCHEMA_SYNC=false

# Optional image mirrors and loopback diagnostics ports.
# DOCKER_REGISTRY=docker.m.daocloud.io/library/
# NPM_REGISTRY=https://registry.npmmirror.com
# CERTBOT_EMAIL=ops@example.com
# ERP_MYSQL_HOST_PORT=3307
# ERP_BACKEND_PORT=3000
# ERP_FRONTEND_PORT=5180
