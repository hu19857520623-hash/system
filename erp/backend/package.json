{
  "name": "erp-backend",
  "version": "0.1.0",
  "description": "Takealot ERP 后端服务 · NestJS + Prisma + MySQL",
  "author": "",
  "private": true,
  "scripts": {
    "build": "nest build && node scripts/postbuild.cjs",
    "start": "nest start",
    "start:dev": "npm run build && nest start --watch",
    "prestart:prod": "npm run verify:schema",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:pull": "prisma db pull",
    "migrate:all": "ts-node prisma/migrate-all.ts",
    "migrate:baseline": "ts-node prisma/migrate-all.ts --baseline",
    "migrate:schema": "npx prisma db execute --file prisma/scripts/migrate_schema_full_sync.sql",
    "verify:schema": "node scripts/verify-schema-sync.mjs",
    "sync:shared": "tsc -p ../shared/tsconfig.json",
    "sync:permissions": "npm run sync:shared && ts-node -r tsconfig-paths/register prisma/sync-permissions.ts",
    "sync:java-permissions": "npm run sync:shared && node ../shared/sync-java-permission-constants.mjs",
    "uat:outbound": "ts-node scripts/uat-outbound.ts",
    "seed": "npm run sync:shared && ts-node -r tsconfig-paths/register prisma/seed.ts",
    "import:leads": "ts-node prisma/import-leads-xlsx.ts",
    "import:local-exports": "ts-node prisma/import-local-exports.ts",
    "backfill:finance-costs": "ts-node -r tsconfig-paths/register prisma/backfill-finance-cost-ledger.ts",
    "lint": "eslint src prisma scripts --max-warnings=0",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "moduleNameMapper": {
      "^@erp/shared/(.*)$": "<rootDir>/../shared/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/main.ts"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cos-nodejs-sdk-v5": "^2.15.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.7.4",
    "@types/passport-jwt": "^4.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^29.7.0",
    "prisma": "^5.20.0",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.65.0",
    "xlsx": "^0.18.5"
  }
}
