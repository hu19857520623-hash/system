# 数据库连接（本地 MySQL takealot_erp）
DATABASE_URL="mysql://用户名:密码@localhost:3306/takealot_erp"

# JWT 配置
JWT_SECRET="请替换为随机密钥"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:5173,http://localhost:8080"

# 服务端口
PORT=3000

# OMS 状态自动回传（ERP 作业节点推送）
OMS_WEBHOOK_URL=http://127.0.0.1:3001/api/erp/webhooks/events
OMS_WEBHOOK_SECRET="请替换为 ERP 与 OMS 共用的随机密钥"

# OMS 服务调用 ERP 内部开户接口（与 OMS 服务配置保持一致）
OMS_INTERNAL_TOKEN="请替换为 ERP 与 OMS 共用的随机密钥"
OMS_INTERNAL_TOKEN_HEADER="x-oms-internal-token"
