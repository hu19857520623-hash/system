# 数据库连接（本地 MySQL takealot_erp）
DATABASE_URL="mysql://用户名:密码@localhost:3306/takealot_erp"

# JWT 配置
JWT_SECRET="请替换为随机密钥"
JWT_EXPIRES_IN="7d"
CORS_ORIGINS="http://localhost:5180,http://127.0.0.1:5180,http://localhost:5173,http://localhost:8080"

# 服务端口（默认只监听本机，Docker 内请设 LISTEN_HOST=0.0.0.0）
PORT=3000
LISTEN_HOST=127.0.0.1

# OMS 状态自动回传（ERP 作业节点推送）
OMS_WEBHOOK_URL=http://127.0.0.1:3001/api/erp/webhooks/events
OMS_WEBHOOK_SECRET="请替换为 ERP 与 OMS 共用的随机密钥"

# OMS 服务调用 ERP 内部开户接口（与 OMS 服务配置保持一致）
OMS_INTERNAL_TOKEN="请替换为 ERP 与 OMS 共用的随机密钥"
OMS_INTERNAL_TOKEN_HEADER="x-oms-internal-token"

# Takealot 店铺 API Key 加密（缺省回退 JWT_SECRET）
# STORE_API_KEY_SECRET="请替换为独立的随机密钥"

# 明瑞物流 AI-OPS（查询跟踪状态与订单信息；未配置时采购主管仍可保存草稿）
# MINGRUI_API_BASE=https://ws.ai-ops.vip
# MINGRUI_APP_KEY=
# MINGRUI_APP_TOKEN=
