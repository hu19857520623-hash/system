// Takealot ERP · Prisma schema
// 映射本地 MySQL 数据库 takealot_erp 已有表结构
// 列名 snake_case 通过 @map 映射为代码内 camelCase

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ───────────── 用户与权限 ─────────────

model SysUser {
  id           BigInt    @id @default(autoincrement())
  username     String    @unique @db.VarChar(50)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  realName     String    @map("real_name") @db.VarChar(50)
  phone        String?   @db.VarChar(20)
  email        String?   @db.VarChar(100)
  avatarUrl    String?   @map("avatar_url") @db.VarChar(500)
  roleCode     String    @default("viewer") @map("role_code") @db.VarChar(30)
  status       Int       @default(1) @db.TinyInt
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("sys_user")
}

model SysRole {
  id          Int      @id @default(autoincrement())
  roleCode    String   @unique @map("role_code") @db.VarChar(30)
  roleName    String   @map("role_name") @db.VarChar(50)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("sys_role")
}

model SysPermission {
  id          Int     @id @default(autoincrement())
  permCode    String  @unique @map("perm_code") @db.VarChar(60)
  permName    String  @map("perm_name") @db.VarChar(80)
  module      String  @db.VarChar(30)
  description String? @db.Text

  @@map("sys_permission")
}

model SysRolePermission {
  roleCode String @map("role_code") @db.VarChar(30)
  permCode String @map("perm_code") @db.VarChar(60)

  @@id([roleCode, permCode])
  @@map("sys_role_permission")
}

model SysUserPermission {
  userId   BigInt @map("user_id")
  permCode String @map("perm_code") @db.VarChar(60)

  @@id([userId, permCode])
  @@map("sys_user_permission")
}

// ───────────── 供应商 ─────────────

model Supplier {
  id           BigInt   @id @default(autoincrement())
  supplierCode String   @unique @map("supplier_code") @db.VarChar(30)
  supplierName String   @map("supplier_name") @db.VarChar(200)
  contactName  String?  @map("contact_name") @db.VarChar(50)
  contactPhone String?  @map("contact_phone") @db.VarChar(30)
  email        String?  @db.VarChar(100)
  address      String?  @db.VarChar(500)
  city         String?  @db.VarChar(50)
  country      String?  @default("China") @db.VarChar(50)
  paymentTerms String?  @map("payment_terms") @db.VarChar(100)
  leadTimeDays Int?     @map("lead_time_days")
  rating       Int?     @default(3) @db.TinyInt
  status       Int      @default(1) @db.TinyInt
  remark       String?  @db.Text
  createdBy    BigInt?  @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("supplier")
}

// ───────────── 商品主数据 ─────────────

model Product {
  id          BigInt   @id @default(autoincrement())
  sku         String   @unique @db.VarChar(30)
  customerSku String?  @map("customer_sku") @db.VarChar(50)
  spu         String?  @db.VarChar(30)
  productName String   @map("product_name") @db.VarChar(300)
  spec        String?  @db.VarChar(100)
  category    String?  @db.VarChar(50)
  brand       String?  @db.VarChar(50)
  lengthCm    Decimal? @map("length_cm") @db.Decimal(8, 2)
  widthCm     Decimal? @map("width_cm") @db.Decimal(8, 2)
  heightCm    Decimal? @map("height_cm") @db.Decimal(8, 2)
  measuredLengthCm Decimal? @map("measured_length_cm") @db.Decimal(8, 2)
  measuredWidthCm  Decimal? @map("measured_width_cm") @db.Decimal(8, 2)
  measuredHeightCm Decimal? @map("measured_height_cm") @db.Decimal(8, 2)
  measuredAt       DateTime? @map("measured_at")
  weightKg    Decimal? @map("weight_kg") @db.Decimal(8, 3)
  costRmb            Decimal? @map("cost_rmb") @db.Decimal(12, 2)
  seaFreightPerUnit  Decimal? @default(0) @map("sea_freight_per_unit") @db.Decimal(12, 2)
  domesticFeePerUnit Decimal? @default(0) @map("domestic_fee_per_unit") @db.Decimal(12, 2)
  barcode     String?  @db.VarChar(50)
  declaredNameEn String? @map("declared_name_en") @db.VarChar(300)
  declaredNameCn String? @map("declared_name_cn") @db.VarChar(300)
  unit        String?  @db.VarChar(20)
  hasBattery  Boolean  @default(false) @map("has_battery")
  imageUrl    String?  @map("image_url") @db.VarChar(500)
  takealotUrl String?  @map("takealot_url") @db.VarChar(500)
  developerId BigInt?  @map("developer_id")
  purchaserId BigInt?  @map("purchaser_id")
  supplierId  BigInt?  @map("supplier_id")
  status      String   @default("active") @db.VarChar(20)
  syncStatus  String?  @default("pending") @map("sync_status") @db.VarChar(30)
  remark      String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  images ProductImage[]

  @@index([supplierId], map: "idx_product_supplier")
  @@index([status], map: "idx_product_status")
  @@index([customerSku], map: "idx_product_customer_sku")
  @@map("product")
}

model ProductImage {
  id        BigInt   @id @default(autoincrement())
  productId BigInt   @map("product_id")
  imageUrl  String   @map("image_url") @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId], map: "idx_product_image_product")
  @@map("product_image")
}

// ───────────── 选品开发 ─────────────

model ProductDev {
  id                    BigInt    @id @default(autoincrement())
  applyNo               String    @unique @map("apply_no") @db.VarChar(30)
  sku                   String?   @unique @db.VarChar(30)
  productName           String    @map("product_name") @db.VarChar(300)
  takealotUrl           String?   @map("takealot_url") @db.VarChar(500)
  takealotPriceImageUrl String?   @map("takealot_price_image_url") @db.VarChar(500)
  amazonUrl             String?   @map("amazon_url") @db.VarChar(500)
  alibaba1688Url        String?   @map("alibaba1688_url") @db.VarChar(500)
  alibaba1688ImageUrl   String?   @map("alibaba1688_image_url") @db.VarChar(500)
  spec                  String?   @db.VarChar(100)
  productLengthCm       Decimal?  @map("product_length_cm") @db.Decimal(8, 2)
  productWidthCm        Decimal?  @map("product_width_cm") @db.Decimal(8, 2)
  productHeightCm       Decimal?  @map("product_height_cm") @db.Decimal(8, 2)
  packageLengthCm       Decimal?  @map("package_length_cm") @db.Decimal(8, 2)
  packageWidthCm        Decimal?  @map("package_width_cm") @db.Decimal(8, 2)
  packageHeightCm       Decimal?  @map("package_height_cm") @db.Decimal(8, 2)
  estimatedCost         Decimal?  @map("estimated_cost") @db.Decimal(12, 2)
  marketPrice           Decimal?  @map("market_price") @db.Decimal(12, 2)
  sellPriceRmb          Decimal?  @map("sell_price_rmb") @db.Decimal(12, 2)
  maxSellPriceRmb       Decimal?  @map("max_sell_price_rmb") @db.Decimal(12, 2)
  seaFreightChannel     String?   @map("sea_freight_channel") @db.VarChar(30)
  volumetricWeightKg    Decimal?  @map("volumetric_weight_kg") @db.Decimal(10, 3)
  cbm                   Decimal?  @db.Decimal(10, 6)
  reason                String?   @db.Text
  status                String    @default("draft") @db.VarChar(20)
  applicantId           BigInt?   @map("applicant_id")
  auditorId             BigInt?   @map("auditor_id")
  auditRemark           String?   @map("audit_remark") @db.Text
  auditedAt             DateTime? @map("audited_at")
  purchaseQty           Int?      @map("purchase_qty")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("product_dev")
}

// ───────────── 采购订单 ─────────────

model PurchaseOrder {
  id              BigInt              @id @default(autoincrement())
  poNo            String              @unique @map("po_no") @db.VarChar(30)
  supplierId      BigInt              @map("supplier_id")
  warehouseCode   String?             @map("warehouse_code") @db.VarChar(30)
  totalAmount     Decimal             @default(0) @map("total_amount") @db.Decimal(14, 2)
  domesticFreight Decimal?            @map("domestic_freight") @db.Decimal(12, 2)
  currency        String              @default("RMB") @db.VarChar(10)
  expectedArrival DateTime?           @map("expected_arrival") @db.Date
  status          String              @default("draft") @db.VarChar(30)
  remark          String?             @db.Text
  purchaserId     BigInt?             @map("purchaser_id")
  auditorId       BigInt?             @map("auditor_id")
  auditedAt       DateTime?           @map("audited_at")
  financeId       BigInt?             @map("finance_id")
  financeAt       DateTime?           @map("finance_at")
  poAuditRemark   String?             @map("po_audit_remark") @db.VarChar(500)
  financeRemark   String?             @map("finance_remark") @db.VarChar(500)
  paymentStatus   String              @default("unpaid") @map("payment_status") @db.VarChar(20)
  paidAt          DateTime?           @map("paid_at")
  paidBy          BigInt?             @map("paid_by")
  prePoId         BigInt?             @map("pre_po_id")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  items           PurchaseOrderItem[]

  @@index([supplierId], map: "idx_po_supplier")
  @@index([status], map: "idx_po_status")
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id             BigInt        @id @default(autoincrement())
  poId           BigInt        @map("po_id")
  productId      BigInt        @map("product_id")
  sku            String        @db.VarChar(30)
  productName    String?       @map("product_name") @db.VarChar(300)
  plannedQty     Int?          @map("planned_qty")
  quantity       Int
  unitPrice      Decimal       @map("unit_price") @db.Decimal(12, 2)
  amount         Decimal       @db.Decimal(14, 2)
  domesticFreight Decimal?     @map("domestic_freight") @db.Decimal(12, 2)
  receivedQty    Int?          @default(0) @map("received_qty")
  remark         String?       @db.VarChar(500)
  createdAt      DateTime      @default(now()) @map("created_at")
  order          PurchaseOrder @relation(fields: [poId], references: [id])

  @@index([poId], map: "idx_poi_po")
  @@map("purchase_order_item")
}

// ───────────── 预采购单（审核通过后生成，采购员确认后转正式 PO） ─────────────

model PrePurchaseOrder {
  id                   BigInt    @id @default(autoincrement())
  prePoNo              String    @unique @map("pre_po_no") @db.VarChar(30)
  devId                BigInt    @map("dev_id")
  applyNo              String    @map("apply_no") @db.VarChar(30)
  sku                  String    @db.VarChar(30)
  productName          String    @map("product_name") @db.VarChar(300)
  spec                 String?   @db.VarChar(100)
  plannedQty           Int       @map("planned_qty")
  unitPrice            Decimal?  @map("unit_price") @db.Decimal(12, 2)
  supplierId           BigInt?   @map("supplier_id")
  supplierContactName  String?   @map("supplier_contact_name") @db.VarChar(50)
  supplierContactPhone String?   @map("supplier_contact_phone") @db.VarChar(30)
  supplierAddress      String?   @map("supplier_address") @db.VarChar(500)
  productLink          String?   @map("product_link") @db.VarChar(500)
  accessories          String?   @db.Text
  productImageUrl      String?   @map("product_image_url") @db.VarChar(500)
  manualUrl            String?   @map("manual_url") @db.VarChar(500)
  moq                  Int?
  leadTimeDays         Int?      @map("lead_time_days")
  taxRate              Decimal?  @map("tax_rate") @db.Decimal(5, 2)
  invoiceTaxRate       Decimal?  @map("invoice_tax_rate") @db.Decimal(5, 2)
  unitTax              Decimal?  @map("unit_tax") @db.Decimal(12, 2)
  unitFreight          Decimal?  @map("unit_freight") @db.Decimal(12, 2)
  productLengthCm      Decimal?  @map("product_length_cm") @db.Decimal(8, 2)
  productWidthCm       Decimal?  @map("product_width_cm") @db.Decimal(8, 2)
  productHeightCm      Decimal?  @map("product_height_cm") @db.Decimal(8, 2)
  productVolumeCbm     Decimal?  @map("product_volume_cbm") @db.Decimal(10, 6)
  packageWeightKg      Decimal?  @map("package_weight_kg") @db.Decimal(8, 3)
  packageLengthCm      Decimal?  @map("package_length_cm") @db.Decimal(8, 2)
  packageWidthCm       Decimal?  @map("package_width_cm") @db.Decimal(8, 2)
  packageHeightCm      Decimal?  @map("package_height_cm") @db.Decimal(8, 2)
  packageVolumeCbm     Decimal?  @map("package_volume_cbm") @db.Decimal(10, 6)
  volumetricWeightKg   Decimal?  @map("volumetric_weight_kg") @db.Decimal(10, 3)
  sampleStatus         String?   @map("sample_status") @db.VarChar(100)
  samplePackageInfo    String?   @map("sample_package_info") @db.Text
  sampleImageUrl       String?   @map("sample_image_url") @db.VarChar(500)
  doubleLayerCarton    Boolean?  @map("double_layer_carton")
  notPurchaseReason    String?   @map("not_purchase_reason") @db.Text
  logoUnitFee          Decimal?  @map("logo_unit_fee") @db.Decimal(12, 2)
  logoTotalFee         Decimal?  @map("logo_total_fee") @db.Decimal(14, 2)
  cartonTotalPrice     Decimal?  @map("carton_total_price") @db.Decimal(14, 2)
  spareCartonUnitPrice Decimal?  @map("spare_carton_unit_price") @db.Decimal(12, 2)
  spareCartonQty       Int?      @map("spare_carton_qty")
  piecesPerCarton      Int?      @map("pieces_per_carton")
  domesticFreight      Decimal?  @map("domestic_freight") @db.Decimal(12, 2)
  warehouseCode        String?   @map("warehouse_code") @db.VarChar(30)
  currency             String    @default("RMB") @db.VarChar(10)
  expectedArrival      DateTime? @map("expected_arrival") @db.Date
  purchaserId          BigInt?   @map("purchaser_id")
  assignerId           BigInt?   @map("assigner_id")
  assignedAt           DateTime? @map("assigned_at")
  status               String    @default("pending_assign") @db.VarChar(30)
  cancelReason         String?   @map("cancel_reason") @db.Text
  remark               String?   @db.Text
  convertedPoId        BigInt?   @map("converted_po_id")
  confirmedAt          DateTime? @map("confirmed_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([status], map: "idx_pre_po_status")
  @@index([devId], map: "idx_pre_po_dev")
  @@index([purchaserId], map: "idx_pre_po_purchaser")
  @@map("pre_purchase_order")
}

// ───────────── 仓库 ─────────────

model Warehouse {
  id            Int      @id @default(autoincrement())
  warehouseCode String   @unique @map("warehouse_code") @db.VarChar(30)
  warehouseName String   @map("warehouse_name") @db.VarChar(100)
  warehouseType String   @default("logistics") @map("warehouse_type") @db.VarChar(20)
  address       String?  @db.VarChar(500)
  city          String?  @db.VarChar(50)
  country       String?  @default("South Africa") @db.VarChar(50)
  contactName   String?  @map("contact_name") @db.VarChar(50)
  contactPhone  String?  @map("contact_phone") @db.VarChar(30)
  requiredOutboundFiles String? @map("required_outbound_files") @db.Text
  status        Int      @default(1) @db.TinyInt
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("warehouse")
}

model WarehouseZone {
  id            BigInt              @id @default(autoincrement())
  zoneCode      String              @map("zone_code") @db.VarChar(30)
  zoneName      String              @map("zone_name") @db.VarChar(100)
  warehouseCode String              @map("warehouse_code") @db.VarChar(30)
  zoneType      String              @default("storage") @map("zone_type") @db.VarChar(20)
  status        Int                 @default(1) @db.TinyInt
  remark        String?             @db.VarChar(500)
  createdAt     DateTime            @default(now()) @map("created_at")
  locations     WarehouseLocation[]

  @@unique([warehouseCode, zoneCode], map: "uk_zone_wh")
  @@index([warehouseCode], map: "idx_zone_wh")
  @@map("warehouse_zone")
}

model WarehouseLocation {
  id            BigInt              @id @default(autoincrement())
  locationCode  String              @map("location_code") @db.VarChar(30)
  warehouseCode String              @map("warehouse_code") @db.VarChar(30)
  zoneId        BigInt              @map("zone_id")
  aisle         String?             @db.VarChar(10)
  rack          String?             @db.VarChar(10)
  level         String?             @db.VarChar(10)
  bin           String?             @db.VarChar(10)
  maxVolumeCbm  Decimal?            @map("max_volume_cbm") @db.Decimal(10, 4)
  maxWeightKg   Decimal?            @map("max_weight_kg") @db.Decimal(10, 2)
  status        String              @default("available") @db.VarChar(20)
  remark        String?             @db.VarChar(500)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  zone          WarehouseZone       @relation(fields: [zoneId], references: [id])
  inventoryItems InventoryLocation[]

  @@unique([warehouseCode, locationCode], map: "uk_loc_wh")
  @@index([zoneId], map: "idx_loc_zone")
  @@map("warehouse_location")
}

model InventoryLocation {
  id            BigInt            @id @default(autoincrement())
  productId     BigInt            @map("product_id")
  sku           String            @db.VarChar(30)
  warehouseCode String            @map("warehouse_code") @db.VarChar(30)
  locationId    BigInt            @map("location_id")
  locationCode  String            @map("location_code") @db.VarChar(30)
  qty           Int               @default(0)
  batchNo       String?           @map("batch_no") @db.VarChar(50)
  inboundNo     String?           @map("inbound_no") @db.VarChar(30)
  updatedAt     DateTime          @updatedAt @map("updated_at")
  location      WarehouseLocation @relation(fields: [locationId], references: [id])

  @@unique([productId, locationId, batchNo], map: "uk_inv_loc")
  @@index([sku, warehouseCode], map: "idx_inv_loc_sku")
  @@map("inventory_location")
}

// ───────────── 入库 ─────────────

model InboundOrder {
  id                  BigInt             @id @default(autoincrement())
  inboundNo           String             @unique @map("inbound_no") @db.VarChar(30)
  poId                BigInt?            @map("po_id")
  sourceWarehouseCode String?            @map("source_warehouse_code") @db.VarChar(30)
  warehouseCode       String             @map("warehouse_code") @db.VarChar(30)
  warehouseNo         String?            @map("warehouse_no") @db.VarChar(30)
  trackingNo          String?            @map("tracking_no") @db.VarChar(50)
  status        String             @default("pending_receipt") @db.VarChar(20)
  pushWmsAt     DateTime?          @map("push_wms_at")
  arrivedAt     DateTime?          @map("arrived_at")
  arrivedBy     BigInt?            @map("arrived_by")
  receivedAt    DateTime?          @map("received_at")
  receivedBy    BigInt?            @map("received_by")
  qcAt          DateTime?          @map("qc_at")
  qcBy          BigInt?            @map("qc_by")
  putawayAt     DateTime?          @map("putaway_at")
  putawayBy     BigInt?            @map("putaway_by")
  confirmedAt   DateTime?          @map("confirmed_at")
  confirmedBy   BigInt?            @map("confirmed_by")
  remark        String?            @db.Text
  omsCustomerCode String?          @map("oms_customer_code") @db.VarChar(30)
  inboundType     String?          @map("inbound_type") @db.VarChar(50)
  deliveryMethod  String?          @map("delivery_method") @db.VarChar(50)
  stockSource     String?          @map("stock_source") @db.VarChar(30)
  referenceNo     String?          @map("reference_no") @db.VarChar(100)
  eta             String?          @db.VarChar(40)
  contact         String?          @db.VarChar(100)
  contactPhone    String?          @map("contact_phone") @db.VarChar(50)
  labelPrintCount Int              @default(0) @map("label_print_count")
  receivedCartonCount Int?         @map("received_carton_count")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  items         InboundOrderItem[]
  putawayItems  InboundPutawayItem[]
  cartons       InboundCarton[]

  @@index([omsCustomerCode], map: "idx_inbound_oms_customer")
  @@map("inbound_order")
}

model InboundCarton {
  id         BigInt              @id @default(autoincrement())
  inboundId  BigInt              @map("inbound_id")
  boxCode    String              @map("box_code") @db.VarChar(50)
  boxSeq     Int                 @map("box_seq")
  status     String              @default("pending") @db.VarChar(20)
  receivedAt DateTime?           @map("received_at")
  receivedBy BigInt?             @map("received_by")
  createdAt  DateTime            @default(now()) @map("created_at")
  order      InboundOrder        @relation(fields: [inboundId], references: [id], onDelete: Cascade)
  items      InboundCartonItem[]

  @@unique([inboundId, boxCode], map: "uk_inbound_box_code")
  @@index([inboundId, status], map: "idx_carton_inbound_status")
  @@map("inbound_carton")
}

model InboundCartonItem {
  id            BigInt        @id @default(autoincrement())
  cartonId      BigInt        @map("carton_id")
  inboundItemId BigInt?       @map("inbound_item_id")
  productId     BigInt        @map("product_id")
  sku           String        @db.VarChar(30)
  qty           Int
  carton        InboundCarton @relation(fields: [cartonId], references: [id], onDelete: Cascade)

  @@index([cartonId], map: "idx_carton_item_carton")
  @@map("inbound_carton_item")
}

model InboundArrivalScan {
  id            BigInt   @id @default(autoincrement())
  inboundId     BigInt   @map("inbound_id")
  scanCode      String   @map("scan_code") @db.VarChar(50)
  scanType      String   @map("scan_type") @db.VarChar(20)
  warehouseCode String   @map("warehouse_code") @db.VarChar(30)
  operatorId    BigInt?  @map("operator_id")
  scannedAt     DateTime @default(now()) @map("scanned_at")

  @@index([inboundId], map: "idx_arrival_inbound")
  @@index([warehouseCode, scannedAt], map: "idx_arrival_wh_time")
  @@map("inbound_arrival_scan")
}

model InboundOrderItem {
  id          BigInt       @id @default(autoincrement())
  inboundId   BigInt       @map("inbound_id")
  productId   BigInt       @map("product_id")
  sku         String       @db.VarChar(30)
  expectedQty Int          @map("expected_qty")
  actualQty   Int?         @map("actual_qty")
  diffQty     Int?         @default(0) @map("diff_qty")
  qcStatus    String?      @default("pending") @map("qc_status") @db.VarChar(20)
  qcRemark    String?      @map("qc_remark") @db.VarChar(500)
  putawayQty  Int?         @default(0) @map("putaway_qty")
  remark      String?      @db.VarChar(500)
  createdAt   DateTime     @default(now()) @map("created_at")
