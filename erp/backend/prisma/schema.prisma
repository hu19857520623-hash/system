  platformCommission  Decimal? @default(0) @map("platform_commission") @db.Decimal(12, 2)
  platformCommissionRate Decimal? @default(15) @map("platform_commission_rate") @db.Decimal(6, 2)
  platformDeliveryFee Decimal? @default(0) @map("platform_delivery_fee") @db.Decimal(12, 2)
  pricingStatus     String    @default("waiting_freight") @map("pricing_status") @db.VarChar(30)
