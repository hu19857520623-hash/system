  domesticFee       Decimal   @default(0) @map("domestic_fee") @db.Decimal(12, 2)
  exchangeRate      Decimal   @default(2.5) @map("exchange_rate") @db.Decimal(10, 4)
  freightCallbackAt DateTime? @map("freight_callback_at")
  marketPrice       Decimal?  @map("market_price") @db.Decimal(12, 2)
  pricingLogic      String?   @map("pricing_logic") @db.VarChar(500)
  targetProfitRate  Decimal?  @map("target_profit_rate") @db.Decimal(6, 2)
  finalPrice        Decimal?  @map("final_price") @db.Decimal(12, 2)
